include_guard(GLOBAL)

function(mcvr_prepare_sharc source_dir output_dir)
    if(NOT EXISTS "${source_dir}/include/SharcCommon.h")
        message(FATAL_ERROR "SHARC is missing. Run git submodule update --init extern/sharc.")
    endif()

    file(GLOB headers CONFIGURE_DEPENDS "${source_dir}/include/*.h")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${headers})
    file(MAKE_DIRECTORY "${output_dir}/include")
    foreach(header IN LISTS headers)
        get_filename_component(name "${header}" NAME)
        set(output_header "${output_dir}/include/${name}")
        configure_file("${header}" "${output_header}" @ONLY NEWLINE_STYLE LF)
        if(name STREQUAL "HashGridCommon.h" OR name STREQUAL "SharcCommon.h")
            file(READ "${output_header}" contents)
            string(REGEX MATCHALL "uint64_t\\(" casts_before "${contents}")
            list(LENGTH casts_before count_before)
            set(shift_count "HASH_GRID_POSITION_BIT_NUM \\* [0-3]( \\+ HASH_GRID_LEVEL_BIT_NUM)?")
            string(REGEX REPLACE "(hashKey >>) (0|32|${shift_count})" "\\1 uint64_t(\\2)" contents "${contents}")
            string(REGEX REPLACE "(<<|>>) \\((${shift_count})\\)" "\\1 uint64_t(\\2)" contents "${contents}")
            string(REGEX MATCHALL "uint64_t\\(" casts_after "${contents}")
            list(LENGTH casts_after count_after)
            math(EXPR added_casts "${count_after} - ${count_before}")
            if(name STREQUAL "HashGridCommon.h")
                set(expected_casts 11)
            else()
                set(expected_casts 9)
            endif()
            if(NOT added_casts EQUAL expected_casts)
                message(FATAL_ERROR "SHARC shift expressions changed in ${name}: expected ${expected_casts} conversions, found ${added_casts}.")
            endif()
            file(WRITE "${output_header}" "${contents}")
        endif()
    endforeach()
endfunction()
