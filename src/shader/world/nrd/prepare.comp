const float NRD_INF_DEPTH = 65504.0;
const float NRD_RELAX_MAX_RADIANCE = 250.0;

const float NRD_HALF_RATE_ENVIRONMENT_MATERIAL = 3.0;
const vec4 REBLUR_HIT_DISTANCE_PARAMETERS = vec4(3.0, 0.1, 20.0, -25.0);
const float NRD_GLOSSY_FIREFLY_MAX_DIRECT_ROUGHNESS = 0.35;
const float NRD_GLOSSY_FIREFLY_NORMAL_THRESHOLD = 0.90;
const float NRD_GLOSSY_FIREFLY_ROUGHNESS_TOLERANCE = 0.15;
const int NRD_GLOSSY_FIREFLY_MIN_NEIGHBORS = 3;
const int NRD_GLOSSY_FIREFLY_COHERENT_SUPPORT = 3;
const uint NRD_FIREFLY_INDIRECT_SPECULAR = 0u;
const uint NRD_FIREFLY_DIRECT_SPECULAR = 1u;
const uint NRD_FIREFLY_TRANSMISSION_DIFFUSE = 2u;
const int NRD_DIFFUSE_RECONSTRUCTION_RADIUS = 2;
const int NRD_DIFFUSE_RECONSTRUCTION_SOURCE_TILE_WIDTH = 32 + 2 * NRD_DIFFUSE_RECONSTRUCTION_RADIUS;
const int NRD_DIFFUSE_RECONSTRUCTION_TILE_WIDTH = NRD_DIFFUSE_RECONSTRUCTION_SOURCE_TILE_WIDTH / 2;
const int NRD_DIFFUSE_RECONSTRUCTION_TILE_HEIGHT = 16 + 2 * NRD_DIFFUSE_RECONSTRUCTION_RADIUS;
const int NRD_DIFFUSE_RECONSTRUCTION_TILE_COUNT =
    NRD_DIFFUSE_RECONSTRUCTION_TILE_WIDTH * NRD_DIFFUSE_RECONSTRUCTION_TILE_HEIGHT;
const int NRD_DIFFUSE_RECONSTRUCTION_MIN_SAMPLES = 3;
const float NRD_DIFFUSE_RECONSTRUCTION_NORMAL_THRESHOLD = 0.90;
const float NRD_DIFFUSE_RECONSTRUCTION_DEPTH_SCALE = 0.003;
const float NRD_DIFFUSE_RECONSTRUCTION_MIN_DEPTH_TOLERANCE = 0.01;

shared vec4 nrdDiffuseReconstructionIrradiance[400];
shared vec4 nrdDiffuseReconstructionNormalDepth[400];
