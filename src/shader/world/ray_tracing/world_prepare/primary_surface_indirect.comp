#version 460
#extension GL_GOOGLE_include_directive : require

#ifndef RASTER_INDIRECT_WORKGROUP_SIZE
#    define RASTER_INDIRECT_WORKGROUP_SIZE 64
#endif

#ifndef RASTER_VISIBILITY_BOUNDS_CLASS_COUNT
#    define RASTER_VISIBILITY_BOUNDS_CLASS_COUNT 3
#endif

layout(local_size_x = RASTER_INDIRECT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#include "common/shared.hpp"

struct AccelerationStructureInstance {
    vec4 transform0;
    vec4 transform1;
    vec4 transform2;
    uint customIndexAndMask;
    uint sbtOffsetAndFlags;
    uint referenceLow;
    uint referenceHigh;
};

struct DrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

struct RenderIndirectMetadataHeader {
    uint drawCount;
    uint metadataOffsetBytes;
    uint metadataStrideBytes;
    uint commandStrideBytes;
    uint chunkInstanceIndexBase;
    uint chunkGeometryAddressIndexBase;
    uint entityInstanceCount;
    uint entityGeometryCount;
    uint chunkInstanceCount;
    uint chunkGeometrySlotCount;
};

struct RenderIndirectDrawMetadata {
    uint objectType;
    uint objectIndex;
    uint geometryIndex;
    uint instanceIndex;
    uint geometryAddressIndex;
    uint vertexCount;
    uint indexCount;
    uint layerOrder;
    uint renderLayerHashLow;
    uint renderLayerHashHigh;
    uint flags;
    uint reserved;
};

layout(set = 6, binding = 0, std430) readonly buffer RasterPrimaryGBufferIndirectMetadata {
    RenderIndirectMetadataHeader header;
    RenderIndirectDrawMetadata metadata[];
}
rasterPrimaryGBufferMetadata;

layout(set = 1, binding = 10, std430) readonly buffer TlasInstances {
    AccelerationStructureInstance instances[];
}
tlasInstances;

layout(set = 6, binding = 1, std430) buffer RasterPrimaryGBufferIndirectCommands {
    DrawIndirectCommand commands[];
}
rasterPrimaryGBufferCommands;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

const uint RASTER_VISIBILITY_BOUNDS_CHUNK = 0u;
const uint RASTER_VISIBILITY_BOUNDS_ENTITY = 1u;
const uint RASTER_VISIBILITY_BOUNDS_CLOUDS = 2u;
const vec3 RASTER_ENTITY_LOCAL_BOUNDS_MIN = vec3(-8.0);
const vec3 RASTER_ENTITY_LOCAL_BOUNDS_MAX = vec3(8.0);
const uint RENDER_LAYER_HASH_CLOUDS_LOW = 2254175127u;
const uint RENDER_LAYER_HASH_CLOUDS_HIGH = 1931664976u;

bool isCloudDraw(RenderIndirectDrawMetadata drawMetadata) {
    return drawMetadata.renderLayerHashLow == RENDER_LAYER_HASH_CLOUDS_LOW &&
           drawMetadata.renderLayerHashHigh == RENDER_LAYER_HASH_CLOUDS_HIGH;
}

uint visibilityBoundsClass(RenderIndirectDrawMetadata drawMetadata) {
    if (drawMetadata.objectType == 0u) { return RASTER_VISIBILITY_BOUNDS_CHUNK; }
    if (isCloudDraw(drawMetadata)) { return RASTER_VISIBILITY_BOUNDS_CLOUDS; }
    return RASTER_VISIBILITY_BOUNDS_ENTITY;
}

bool resolvePrimaryDrawInstanceIndex(RenderIndirectDrawMetadata drawMetadata, out uint instanceIndex) {
    instanceIndex = drawMetadata.instanceIndex;
    if (drawMetadata.objectType == 0u) {
        if (instanceIndex >= rasterPrimaryGBufferMetadata.header.chunkInstanceCount ||
            drawMetadata.geometryAddressIndex >= rasterPrimaryGBufferMetadata.header.chunkGeometrySlotCount) {
            return false;
        }
        instanceIndex += rasterPrimaryGBufferMetadata.header.chunkInstanceIndexBase;
        return true;
    }
    return instanceIndex < rasterPrimaryGBufferMetadata.header.entityInstanceCount &&
           drawMetadata.geometryAddressIndex < rasterPrimaryGBufferMetadata.header.entityGeometryCount;
}

vec3 transformPoint(AccelerationStructureInstance instance, vec3 position) {
    return vec3(dot(instance.transform0.xyz, position) + instance.transform0.w,
                dot(instance.transform1.xyz, position) + instance.transform1.w,
                dot(instance.transform2.xyz, position) + instance.transform2.w);
}

bool outsideClipBox(AccelerationStructureInstance instance, vec3 localMin, vec3 localMax) {
    mat4 worldToClip = worldUBO.cameraProjMat * worldUBO.cameraEffectedViewMat;
    bool outsideLeft = true;
    bool outsideRight = true;
    bool outsideBottom = true;
    bool outsideTop = true;
    bool outsideNear = true;
    bool outsideFar = true;

    for (uint corner = 0u; corner < 8u; corner++) {
        vec3 localPosition =
            vec3((corner & 1u) == 0u ? localMin.x : localMax.x, (corner & 2u) == 0u ? localMin.y : localMax.y,
                 (corner & 4u) == 0u ? localMin.z : localMax.z);
        vec4 clipPosition = worldToClip * vec4(transformPoint(instance, localPosition), 1.0);
        outsideLeft = outsideLeft && clipPosition.x < -clipPosition.w;
        outsideRight = outsideRight && clipPosition.x > clipPosition.w;
        outsideBottom = outsideBottom && clipPosition.y < -clipPosition.w;
        outsideTop = outsideTop && clipPosition.y > clipPosition.w;
        outsideNear = outsideNear && clipPosition.z < 0.0;
        outsideFar = outsideFar && clipPosition.z > clipPosition.w;
    }

    return outsideLeft || outsideRight || outsideBottom || outsideTop || outsideNear || outsideFar;
}

bool isDrawVisible(RenderIndirectDrawMetadata drawMetadata) {
    uint instanceIndex;
    if (!resolvePrimaryDrawInstanceIndex(drawMetadata, instanceIndex)) { return false; }
    AccelerationStructureInstance instance = tlasInstances.instances[instanceIndex];
    uint boundsClass = visibilityBoundsClass(drawMetadata);
    if (boundsClass == RASTER_VISIBILITY_BOUNDS_CHUNK) { return !outsideClipBox(instance, vec3(0.0), vec3(16.0)); }
    if (boundsClass == RASTER_VISIBILITY_BOUNDS_CLOUDS) {
        return !outsideClipBox(instance, vec3(-384.0, 0.0, -384.0), vec3(396.0, 4.0, 396.0));
    }
    return !outsideClipBox(instance, RASTER_ENTITY_LOCAL_BOUNDS_MIN, RASTER_ENTITY_LOCAL_BOUNDS_MAX);
}

void main() {
    uint drawIndex = gl_GlobalInvocationID.x;
    uint drawCount = rasterPrimaryGBufferMetadata.header.drawCount;
    if (drawIndex >= drawCount) { return; }

    RenderIndirectDrawMetadata drawMetadata = rasterPrimaryGBufferMetadata.metadata[drawIndex];
    uint drawVertexCount = drawMetadata.indexCount - drawMetadata.indexCount % 3u;
    bool visible = drawVertexCount > 0u && drawMetadata.vertexCount > 0u && isDrawVisible(drawMetadata);
    rasterPrimaryGBufferCommands.commands[drawIndex] =
        DrawIndirectCommand(drawVertexCount, visible ? 1u : 0u, 0u, drawIndex);
}
